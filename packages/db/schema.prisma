generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Portal Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // bcrypt hash; null for OAuth-only users
  isActive      Boolean   @default(true)
  timezone      String    @default("UTC")
  notificationConfig Json?
  ssoProvider   String?
  ssoId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")
  integrations     Integration[]     @relation("UserIntegrations")
  groupMembers     WorkspaceGroupMember[]

  // PM Module opposite relations
  assignedIssues   PmIssue[]         @relation("IssueAssignee")
  createdIssues    PmIssue[]         @relation("IssueCreator")
  pmComments       PmComment[]
  pmActivities     PmIssueActivity[]
  pmProjectMembers PmProjectMember[]
  pmAttachments    PmAttachment[]
  pmNotifications  PmNotification[]
  pmSavedViews     PmSavedView[]
  pmFavorites      PmFavorite[]      @relation("UserFavorites")
  pmRecentViews    PmRecentView[]    @relation("UserRecentViews")
  pmTimeLogs       PmTimeLog[]       @relation("UserTimeLogs")

  sentInvites      WorkspaceInvite[] @relation("UserSentInvites")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  modules   WorkspaceModule[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]
  integrations Integration[] @relation("WorkspaceIntegrations")
  groups    WorkspaceGroup[]
  invites   WorkspaceInvite[]

  // PM Module opposite relations
  pmTeams    PmTeam[]
  pmProjects PmProject[]
  pmIssues   PmIssue[]
  pmSprints  PmSprint[]
  pmVersions PmVersion[]
  pmComments PmComment[]
  pmLabels   PmLabel[]
  pmTemplates PmIssueTemplate[] @relation("WorkspaceIssueTemplates")
  pmImportJobs PmImportJob[]    @relation("WorkspaceImportJobs")
}

// Groups within a workspace (org-level teams / access groups)
model WorkspaceGroup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceGroupMember[]
  boardAccess PmBoardAccess[]        @relation("GroupBoardAccess")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group WorkspaceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceModule {
  id          String   @id @default(cuid())
  workspaceId String
  moduleId    String // e.g., "pm", "traces"
  enabled     Boolean  @default(false)
  config      Json? // Optional JSON config for module specific settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  email       String
  token       String       @unique
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  status      InviteStatus  @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("UserSentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique // Hashed/Encrypted key
  name        String
  workspaceId String
  userId      String? // Optional: if key is tied to a specific user
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String // e.g., "module.enabled", "user.invited"
  entityType  String // e.g., "WorkspaceModule"
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// Integrations & Webhooks
// -----------------------------------------------------------------------------

model Integration {
  id            String   @id @default(cuid())
  userId        String?  // Can be user-specific (e.g. personal calendar)
  workspaceId   String?  // Or workspace-specific (e.g. Jira import for whole workspace)
  type          String   // "calendar", "git", "pm", "design"
  provider      String   // "google", "outlook", "github", "gitlab", "jira", "figma"
  accessToken   String   // encrypted
  refreshToken  String?  // encrypted
  metadata      Json?    // to store external IDs, custom sync states, webhook URLs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?      @relation("UserIntegrations", fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation("WorkspaceIntegrations", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([type, provider])
}

// -----------------------------------------------------------------------------
// Module: PM Models
// -----------------------------------------------------------------------------

model PmTeam {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  PmProject[]
}

enum PmProjectRole {
  PROJECT_ADMIN
  TEAM_LEADER
  DEVELOPER
  VIEWER
}

model PmProjectMember {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  role      PmProjectRole @default(DEVELOPER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model PmProject {
  id          String   @id @default(cuid())
  workspaceId String
  teamId      String?
  key         String   @unique // e.g., FPM
  name        String
  description String?
  workflow    Json?
  isPrivate   Boolean  @default(false) // if true, only explicit grants can access
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team        PmTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  issues      PmIssue[]
  sprints     PmSprint[]
  labels      PmLabel[]
  members     PmProjectMember[]
  versions    PmVersion[]
  webhooks    PmWebhook[]
  savedViews  PmSavedView[]
  boardAccess PmBoardAccess[]
  templates     PmIssueTemplate[] @relation("ProjectIssueTemplates")
  pmImportJobs  PmImportJob[]     @relation("ProjectImportJobs")
}

// ─────────────────────────────────────────────────────────────────────
// Board Access Grants (fine-grained sharing)
// ─────────────────────────────────────────────────────────────────────

enum PmBoardEntityType {
  USER
  GROUP
}

enum PmBoardRole {
  VIEWER
  EDITOR
}

model PmBoardAccess {
  id         String            @id @default(cuid())
  projectId  String
  entityType PmBoardEntityType
  entityId   String            // userId or groupId
  role       PmBoardRole       @default(VIEWER)
  grantedById String?          // who granted this
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  project PmProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group   WorkspaceGroup? @relation("GroupBoardAccess", fields: [entityId], references: [id], onDelete: Cascade, map: "PmBoardAccess_group_fk")

  @@unique([projectId, entityType, entityId])
  @@index([projectId])
  @@index([entityId])
}

enum PmIssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PmIssueType {
  INITIATIVE
  EPIC
  FEATURE
  STORY
  TASK
  SUBTASK
  BUG
  TEST
}

model PmIssue {
  id               String          @id @default(cuid())
  workspaceId      String?
  projectId        String
  key              String          @unique // e.g., FPM-123
  title            String
  description      String?
  status           String          @default("TODO")
  priority         PmIssuePriority @default(NONE)
  type             PmIssueType     @default(TASK)
  storyPoints      Int?
  complexityScore  Int?
  predictedTime    String?
  originalEstimate Int? // minutes
  timeSpent        Int? // minutes
  remainingTime    Int? // minutes
  customFields     Json?

  dueDate          DateTime?
  startDate        DateTime?
  slaPolicy        String?
  cronSchedule     String?

  parentId   String?
  assigneeId String?
  creatorId  String
  sprintId   String?
  versionId  String?

  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedById String?

  project   PmProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    PmIssue?   @relation("IssueToIssue", fields: [parentId], references: [id], onDelete: SetNull)
  children  PmIssue[]  @relation("IssueToIssue")
  assignee  User?      @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User       @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  sprint    PmSprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  versionInfo PmVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull) // Renamed due to field collision

  comments    PmComment[]
  labels      PmLabel[]         @relation("IssueLabels")
  activities  PmIssueActivity[]
  attachments PmAttachment[]
  snapshots   PmIssueSnapshot[]
  gitlabLinks PmGitLabLink[]
  checklists  PmIssueChecklist[]
  sourceLinks PmIssueLink[]      @relation("SourceLinks")
  targetLinks PmIssueLink[]      @relation("TargetLinks")
  timeLogs    PmTimeLog[]
  gitLinks    PmGitLink[]
}

model PmIssueSnapshot {
  id        String   @id @default(cuid())
  issueId   String
  payload   Json
  createdAt DateTime @default(now())

  issue PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model PmIssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  issue PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model PmSprint {
  id          String    @id @default(cuid())
  workspaceId String?
  projectId   String
  name        String
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   PmProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    PmIssue[]
}

model PmComment {
  id          String    @id @default(cuid())
  workspaceId String?
  issueId     String
  authorId    String
  content     String
  parentId    String? // For threaded replies
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     PmIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PmComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   PmComment[] @relation("CommentReplies")
  mentions  PmCommentMention[]
}

model PmCommentMention {
  id        String    @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime  @default(now())

  comment PmComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model PmLabel {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  name        String
  color       String   @default("#808080")
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   PmProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    PmIssue[]  @relation("IssueLabels")
}

model PmAttachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String
  url        String
  size       Int // bytes
  mimeType   String
  createdAt  DateTime @default(now())

  issue    PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model PmVersion {
  id          String    @id @default(cuid())
  workspaceId String?
  projectId   String
  name        String
  description String?
  releaseDate DateTime?
  released    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   PmProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    PmIssue[]
}

model PmNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "issue_assigned" | "issue_updated" | "comment_added" | "mentioned"
  title     String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PmWebhook {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String
  events    Json // string[]
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PmGitLabLink {
  id             String   @id @default(cuid())
  issueId        String
  gitlabProjectId Int
  gitlabIssueId  Int
  gitlabUrl      String
  synced         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  issue PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, gitlabProjectId, gitlabIssueId])
}

model PmSavedView {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Phase 2 New PM Models
// -----------------------------------------------------------------------------

model PmIssueTemplate {
  id               String          @id @default(cuid())
  workspaceId      String?
  projectId        String
  name             String
  description      String?
  defaultType      PmIssueType     @default(TASK)
  defaultPriority  PmIssuePriority @default(NONE)
  defaultLabels    String[]
  fields           Json            // Contains any prefilled description or checklist items
  createdAt        DateTime        @default(now())

  workspace Workspace? @relation("WorkspaceIssueTemplates", fields: [workspaceId], references: [id], onDelete: Cascade)
  project   PmProject  @relation("ProjectIssueTemplates", fields: [projectId], references: [id], onDelete: Cascade)
}

model PmIssueChecklist {
  id          String   @id @default(cuid())
  issueId     String
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue       PmIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

enum PmLinkType {
  BLOCKS
  IS_BLOCKED_BY
  RELATES_TO
  DUPLICATES
}

model PmIssueLink {
  id             String     @id @default(cuid())
  sourceIssueId  String
  targetIssueId  String
  type           PmLinkType @default(RELATES_TO)
  createdAt      DateTime   @default(now())

  sourceIssue    PmIssue    @relation("SourceLinks", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue    PmIssue    @relation("TargetLinks", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, type])
}

model PmFavorite {
  id          String   @id @default(cuid())
  userId      String
  entityType  String   // "project" | "issue" | "view"
  entityId    String
  createdAt   DateTime @default(now())

  user        User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

model PmRecentView {
  id          String   @id @default(cuid())
  userId      String
  entityType  String   // "project" | "issue"
  entityId    String
  viewedAt    DateTime @default(now())

  user        User     @relation("UserRecentViews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  isEnabled      Boolean  @default(false)
  workspaceIds   String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
// Time Tracking
// ─────────────────────────────────────────────────────────────────────

model PmTimeLog {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  minutes   Int
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  issue PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User    @relation("UserTimeLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
// Import Jobs (Jira / other sources)
// ─────────────────────────────────────────────────────────────────────

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model PmImportJob {
  id          String          @id @default(cuid())
  workspaceId String
  projectId   String?
  source      String          // "jira" | "github" | "csv"
  status      ImportJobStatus @default(PENDING)
  progress    Int             @default(0)   // 0–100
  total       Int             @default(0)
  importedCount Int           @default(0)
  error       String?
  metadata    Json?           // store original config
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace @relation("WorkspaceImportJobs", fields: [workspaceId], references: [id], onDelete: Cascade)
  project     PmProject?  @relation("ProjectImportJobs", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────
// Git Links (generic GitHub + GitLab)
// ─────────────────────────────────────────────────────────────────────

enum GitPrStatus {
  OPEN
  MERGED
  CLOSED
  DRAFT
}

model PmGitLink {
  id        String      @id @default(cuid())
  issueId   String
  provider  String      // "github" | "gitlab"
  repoName  String
  prNumber  Int
  prTitle   String?
  prUrl     String
  status    GitPrStatus @default(OPEN)
  branch    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  issue PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, provider, repoName, prNumber])
  @@index([issueId])
}

// ─────────────────────────────────────────────────────────────────────
// Executive Dashboard Share Tokens
// ─────────────────────────────────────────────────────────────────────

model PmShareToken {
  id          String    @id @default(cuid())
  token       String    @unique
  workspaceId String
  projectId   String?
  createdById String?
  expiresAt   DateTime?
  viewCount   Int       @default(0)
  isPublic    Boolean   @default(false)
  passwordHash String?
  createdAt   DateTime  @default(now())

  @@index([token])
}

