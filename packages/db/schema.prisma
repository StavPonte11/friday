generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Portal Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")

  // PM Module opposite relations
  assignedIssues PmIssue[]   @relation("IssueAssignee")
  createdIssues  PmIssue[]   @relation("IssueCreator")
  pmComments     PmComment[]
  statusHistory  PmIssueStatusHistory[]

  // MVP relations
  presence    UserPresence?
  onboarding  UserOnboarding?
  reactions   PmReaction[]
  mentionedIn PmMention[]    @relation("Mentioned")
  mentionsBy  PmMention[]    @relation("MentionedBy")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    WorkspaceMember[]
  modules    WorkspaceModule[]
  apiKeys    ApiKey[]
  auditLogs  AuditLog[]
  components PmComponent[]

  // PM Module opposite relations
  pmProjects PmProject[]
  pmLabels   PmLabel[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceModule {
  id          String   @id @default(cuid())
  workspaceId String
  moduleId    String // e.g., "pm", "traces"
  enabled     Boolean  @default(false)
  config      Json? // Optional JSON config for module specific settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
}

model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique // Hashed/Encrypted key
  name        String
  workspaceId String
  userId      String? // Optional: if key is tied to a specific user
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String // e.g., "module.enabled", "user.invited"
  entityType  String // e.g., "WorkspaceModule"
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// Module: PM Models
// -----------------------------------------------------------------------------

model PmProject {
  id          String   @id @default(cuid())
  workspaceId String
  key         String   @unique // e.g., FPM
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    PmIssue[]
  sprints   PmSprint[]
}

enum PmIssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum PmIssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueRelationType {
  DEPENDS_ON
  BLOCKS
  RELATES_TO
  DUPLICATES
}

model PmIssue {
  id          String          @id @default(cuid())
  projectId   String
  key         String          @unique // e.g., FPM-123
  title       String
  description String?
  status      PmIssueStatus   @default(TODO)
  priority    PmIssuePriority @default(NONE)
  storyPoints Int?
  startDate   DateTime?
  dueDate     DateTime?

  assigneeId String?
  creatorId  String
  sprintId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User      @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  sprint   PmSprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  comments PmComment[]
  labels   PmLabel[]   @relation("IssueLabels")
  mentions PmMention[]
  
  relationsFrom IssueRelation[] @relation("RelationFrom")
  relationsTo   IssueRelation[] @relation("RelationTo")
  components    PmComponent[]   @relation("IssueComponents")
  statusHistory PmIssueStatusHistory[]
  embeddings    MemoryEmbedding[]
}

model PmSprint {
  id        String    @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  PmIssue[]
}

model PmComment {
  id          String   @id @default(cuid())
  issueId     String
  authorId    String
  content     String
  parentId    String?  // null = top-level, set = threaded reply
  isPinned    Boolean  @default(false)
  editHistory Json?    // Array of { content: string, editedAt: string }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue     PmIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PmComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PmComment[] @relation("CommentReplies")
  reactions PmReaction[]
  mentions  PmMention[]
}

model PmLabel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#808080")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    PmIssue[] @relation("IssueLabels")
}

model IssueRelation {
  id          String            @id @default(cuid())
  fromIssueId String
  toIssueId   String
  type        IssueRelationType
  createdAt   DateTime          @default(now())
  
  fromIssue   PmIssue @relation("RelationFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssue     PmIssue @relation("RelationTo", fields: [toIssueId], references: [id], onDelete: Cascade)
  @@unique([fromIssueId, toIssueId, type])
}

model PmComponent {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String   // e.g. service, repo, team, deployment
  ownerId     String?
  metadata    Json?
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues      PmIssue[] @relation("IssueComponents")
}

model PmIssueStatusHistory {
  id        String        @id @default(cuid())
  issueId   String
  status    PmIssueStatus
  userId    String?       // Who made the change
  createdAt DateTime      @default(now())

  issue     PmIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model MemoryEmbedding {
  id        String                 @id @default(cuid())
  issueId   String
  embedding Unsupported("vector(1536)")
  content   String
  createdAt DateTime               @default(now())

  issue     PmIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// MVP: Collaboration Models
// -----------------------------------------------------------------------------

/// Tracks the current online status and viewed page for each user
model UserPresence {
  id          String   @id @default(cuid())
  userId      String   @unique
  status      String   @default("offline") // online | idle | offline
  lastSeenAt  DateTime @default(now())
  currentView String?  // e.g. projectId, issueId, or route path

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Emoji reactions on PmComment
model PmReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment PmComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

/// @mention records linking a user mention inside an issue or comment
model PmMention {
  id            String   @id @default(cuid())
  mentionedId   String   // userId being mentioned
  mentionedById String   // userId doing the mention
  issueId       String?
  commentId     String?
  createdAt     DateTime @default(now())

  mentioned   User       @relation("Mentioned", fields: [mentionedId], references: [id], onDelete: Cascade)
  mentionedBy User       @relation("MentionedBy", fields: [mentionedById], references: [id], onDelete: Cascade)
  issue       PmIssue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment     PmComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// MVP: Feedback & Analytics
// -----------------------------------------------------------------------------

/// In-app feedback submissions from users
model AppFeedback {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // bug | feature | ux | other
  message   String
  page      String?
  projectId String?
  issueId   String?
  createdAt DateTime @default(now())
}

/// Behavioral analytics events emitted by all major user actions
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  event      String   // pm.issue.create | pm.board.move | pm.gantt.view ...
  properties Json?
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// MVP: User Onboarding
// -----------------------------------------------------------------------------

/// Tracks which onboarding steps a new user has completed
model UserOnboarding {
  id             String   @id @default(cuid())
  userId         String   @unique
  completedSteps String[] // ["project", "issue", "invite"]
  skipped        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
